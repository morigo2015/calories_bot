[Unit]
Description=Calories Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=igor
WorkingDirectory=/home/igor/calories-bot
EnvironmentFile=/home/igor/calories-bot/.env
ExecStart=/home/igor/calories-bot/.venv/bin/python -m calories_bot.main
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
